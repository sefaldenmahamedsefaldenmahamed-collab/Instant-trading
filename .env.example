# ─────────────────────────────────────────────────────────────────────────────
# Momentum Sniper — إعدادات البيئة (انسخ هذا الملف إلى .env وعدّل القيم)
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── وضع التشغيل (الأهم!) ─────────────────────────────────────────────────────
# paper   = محاكاة كاملة بأسعار Binance الحية وأموال وهمية (لا يحتاج مفاتيح) ✅ الافتراضي
# testnet = أوامر حقيقية على Binance Testnet بأموال تجريبية (يتطلب مفاتيح testnet)
# live    = أموال حقيقية! ⚠️ تأكد من فهمك لكل الإعدادات قبل تفعيله
MODE=paper

# ── مفاتيح Binance API (مطلوبة فقط لوضعَي testnet و live) ───────────────────
# live:  أنشئها من https://www.binance.com/en/my/settings/api-management
#        ⚠️ فعّل "Enable Spot Trading" فقط — لا تفعّل السحب (Withdrawals) إطلاقاً
#        ⚠️ إن كان لديك قائمة IP مسموحة، أضف IP سيرفر Render
# testnet: أنشئها من https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── رأس المال وإدارة المخاطر ────────────────────────────────────────────────
PAPER_START_BALANCE=100          # رأس مال وضع المحاكاة (USDT)
TRADE_ALLOCATION_PCT=10          # نسبة كل صفقة من الرصيد الحر (%)
MAX_CONCURRENT_TRADES=3          # أقصى عدد صفقات مفتوحة معاً
MAX_TRADES_PER_DAY=6             # أقصى عدد صفقات يومياً
HARD_STOP_LOSS_PCT=-12           # وقف الخسارة الصارم (%)
FEE_PCT=0.1                      # عمولة التنفيذ في المحاكاة (%)
PAPER_SLIPPAGE_PCT=0.15          # انزلاق سعري محاكى (%)
MIN_NOTIONAL_USDT=5              # أدنى قيمة أمر على Binance

# ── الخروج الذكي ────────────────────────────────────────────────────────────
# سلّم أهداف الربح: نسبة الارتفاع : نسبة البيع  (المثال: عند +100% بِع 30%، عند +250% بِع 30%، عند +500% بِع 40%)
TP_LADDER=100:30,250:30,500:40
TRAIL_TRIGGER_PCT=30             # تسليح الوقف المتحرك عند +30%
TRAIL_DROP_PCT=15                # بيع تلقائي إذا هبط السعر 15% عن القمة
MOMENTUM_EXIT_SCORE=40           # خروج احترازي إذا انهارت درجة الزخم تحت هذا الحد
MOMENTUM_EXIT_MAX_GAIN=10        # (الخروج الاحترازي يعمل فقط إذا كان الربح أقل من هذا)

# ── الفحص والاستراتيجية ─────────────────────────────────────────────────────
SCAN_INTERVAL_SEC=60             # كل كم ثانية يمسح السوق
EXIT_CHECK_INTERVAL_SEC=10       # كل كم ثانية يراقب الصفقات المفتوحة
EXTERNAL_SCAN_INTERVAL_SEC=300   # كل كم ثانية يمسح المصادر الخارجية (CoinGecko/Reddit)
ENTRY_SCORE_THRESHOLD=78         # الحد الأدنى لدرجة الزخم للدخول (من 100)
MIN_QUOTE_VOLUME_24H=2000000     # أدنى سيولة يومية (USDT)
FOMO_BLOCK_24H_PCT=80            # درع FOMO: لا شراء عملة ارتفعت أكثر من هذا خلال 24 ساعة
PARABOLIC_1H_PCT=45              # رفض شمعة عمودية: +45% خلال ساعة = مطاردة قمة
MAX_BOOK_SPREAD_PCT=1.0          # أقصى فرق عرض/طلب مسموح (%)
DEEP_DIVE_TOP_N=20               # عدد المرشحين للفحص العميق في كل دورة

# ── الأفكار المجنونة ────────────────────────────────────────────────────────
NEW_LISTING_SNIPE=true           # قنص الإدراج الجديد (مراقبة إعلانات Binance + exchangeInfo)
NEW_LISTING_ALLOCATION_PCT=5     # نسبة صفقة القنص أصغر (إدراج جديد = مخاطرة أعلى)
NEW_LISTING_SKIP_FOMO_GUARD=true # الإدراج الجديد يُستثنى من درع FOMO
NEW_LISTING_TRAIL_TRIGGER=20     # تسليح الترailing أسرع للإدراج الجديد (+20%)
NEW_LISTING_MAX_AGE_HOURS=24
AUTOPSY_LEARNING=true            # التحليل الذاتي: البوت يعدّل معاييره بعد كل صفقة مغلقة

# ── مؤشر الخوف والطمع (سلوك البوت يتبدل تلقائياً) ───────────────────────────
FNG_GREED_THRESHOLD=80           # طمع شديد → رفع سقف الدخول +FNG_GREED_SCORE_PENALTY
FNG_FEAR_THRESHOLD=20            # خوف شديد → تجميد الدخول مؤقتاً
FNG_GREED_SCORE_PENALTY=8

# ── المصادر الخارجية ────────────────────────────────────────────────────────
COINGECKO_BASE=https://api.coingecko.com/api/v3
BINANCE_ANNOUNCE_BASE=https://www.binance.com   # مصدر إعلانات الإدراج الجديد
REDDIT_ENABLED=true              # كشط إشارات r/CryptoCurrency وغيرها (أفضل جهد، بلا مفاتيح)
REDDIT_SUBREDDITS=CryptoCurrency,savememecoins,MemeEconomy
X_BEARER_TOKEN=                  # اختياري: X/Twitter API مدفوع — اتركه فارغاً لتعطيله

# ── الخادم ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000                        # على Render اتركه فارغاً — المنصة تحدد PORT تلقائياً
LOG_LEVEL=INFO
DB_PATH=data/bot.db
